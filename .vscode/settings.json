{
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "All Headings Generic",
        "scope": [
          "markup.heading",
          "markup.heading markdown",
          "markup.heading mdx",
          "entity.name.section.markdown",
          "entity.name.section.mdx"
        ],
        "settings": {
          "foreground": "#569CD6",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown/MDX H1",
        "scope": [
          "markup.heading.1",
          "markup.heading.1.markdown",
          "markup.heading.1.mdx",
          "entity.name.section.markdown.heading.1",
          "punctuation.definition.heading.1"
        ],
        "settings": {
          "foreground": "#FFB86C",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown/MDX H2",
        "scope": [
          "markup.heading.2",
          "markup.heading.2.markdown",
          "markup.heading.2.mdx",
          "entity.name.section.markdown.heading.2",
          "punctuation.definition.heading.2",
          "heading.2.markdown",
          "heading.2.mdx"
        ],
        "settings": {
          "foreground": "#FF79C6",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown/MDX H3",
        "scope": [
          "markup.heading.3",
          "markup.heading.3.markdown",
          "markup.heading.3.mdx",
          "entity.name.section.markdown.heading.3",
          "punctuation.definition.heading.3"
        ],
        "settings": {
          "foreground": "#50FA7B",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown/MDX Heading Hashtags Punctuation",
        "scope": [
          "punctuation.definition.heading",
          "punctuation.definition.heading.markdown",
          "punctuation.definition.heading.mdx"
        ],
        "settings": {
          "foreground": "#BD93F9",
          "fontStyle": "bold"
        }
      }
    ]
  }
}